> Read and modify player XP levels, and set the progress bar by fraction rather than by points.

name: XP
slug: bookshelf-xp
version: 5.0.0
tags: runtime


$out = state > the experience bar is updated


feature function add_levels
  > Add levels to players.
  authors: Aksiome, Leirof
  created: 2022/04/14 1.18.2
  updated: 2026/09/09 26.3

  context executor: player[] > players to add levels to
  input arguments: {
    levels: int > levels to add, negative to remove
  }
  output $out


feature function add_points
  > Add experience points to players.
  authors: Aksiome, Leirof
  created: 2022/04/14 1.18.2
  updated: 2026/09/09 26.3

  context executor: player[] > players to add points to
  input arguments: {
    points: int > points to add, negative to remove
  }
  output $out


feature function add_progress
  > Add progress to the experience bar.
  authors: Aksiome, Leirof
  created: 2023/08/31 1.20.1
  updated: 2026/09/09 26.3

  context executor: player[] > players to add bar progress to
  input arguments: {
    progress: float @ -1..1 > fraction of the bar to add, negative to remove
  }
  output $out


feature function get_progress
  > Get the fill progress of the experience bar.
  authors: Aksiome, Leirof
  created: 2022/04/14 1.18.2
  updated: 2026/09/09 26.3

  context executor: player > player to get the bar progress from
  output storage: float @ 0..1 > fraction of the bar filled


feature function get_remaining_points
  > Get the number of points missing to reach the next level.
  authors: Aksiome, Leirof
  created: 2023/08/31 1.20.1
  updated: 2026/09/09 26.3

  context executor: player > player to get the remaining points from
  output storage: int @ 0.. > points still needed to reach the next level


feature function get_required_points
  > Get the number of points the current level holds.
  authors: Aksiome, Leirof
  created: 2023/08/31 1.20.1
  updated: 2026/09/09 26.3

  context executor: player > player to get the required points from
  output storage: int @ 0.. > points needed to fill the current level


feature function get_total_points
  > Get the total number of points a player has, levels included.
  authors: Aksiome, Leirof
  created: 2022/04/14 1.18.2
  updated: 2026/09/09 26.3

  context executor: player > player to get the total points from
  output storage: int @ 0.. > total number of points, levels included


feature function set_levels
  > Set the level of players.
  authors: Aksiome, Leirof
  created: 2022/04/14 1.18.2
  updated: 2026/09/09 26.3

  context executor: player[] > players to set the levels of
  input arguments: {
    levels: int @ 0.. > level to set
  }
  output $out


feature function set_points
  > Set the experience points of players.
  authors: Aksiome, Leirof
  created: 2022/04/14 1.18.2
  updated: 2026/09/09 26.3

  context executor: player[] > players to set the points of
  input arguments: {
    points: int @ 0.. > points to set within the current level
  }
  output $out


feature function set_progress
  > Set the fill progress of the experience bar.
  authors: Aksiome, Leirof
  created: 2022/04/14 1.18.2
  updated: 2026/09/09 26.3

  context executor: player[] > players to set the bar progress of
  input arguments: {
    progress: float @ 0..1 > fraction of the bar to fill
  }
  output $out


feature function set_total_points
  > Set the total experience points of players.
  authors: Aksiome, Leirof
  created: 2022/04/14 1.18.2
  updated: 2026/09/09 26.3

  context executor: player[] > players to set the total points of
  input arguments: {
    points: int @ 0.. > total number of points to set, levels included
  }
  output $out
