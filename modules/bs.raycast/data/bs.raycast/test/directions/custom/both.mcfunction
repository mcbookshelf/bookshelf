# @template ward:empty/9x9x9

# stone and an entity in each block, pierced towards each octant with a ray mostly along each axis: 24 rays of 12 blocks, on_block and on_entity for each block
fill ~1 ~1 ~1 ~8 ~8 ~8 minecraft:stone
summon minecraft:interaction ~1.5 ~1 ~1.5 {Tags:["bs.raycast.test.custom.both"],width:1f,height:1f}
execute at @e[type=minecraft:interaction,tag=bs.raycast.test.custom.both,dx=8,dy=8,dz=8] run summon minecraft:interaction ~1 ~ ~ {Tags:["bs.raycast.test.custom.both"],width:1f,height:1f}
