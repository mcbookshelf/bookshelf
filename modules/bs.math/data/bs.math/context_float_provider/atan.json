

{
    "Note":"This algorithm is taken from https://web.mae.ufl.edu/uhk/ARCTAN-APPROX-PAPER.pdf with coefficient approximation",
    "type": "conditional",
    "condition": {
        "type": "float_value_check",
        "value": {"type": "abs","input": {"type": "storage","storage": "bs:in","path": "math.atan.x"} },
        "test": {"max": 1}
    },
    "on_true": {
        "type": "conditional",
        "condition": {
            "type": "float_value_check",
            "value": {"type": "storage","storage": "bs:in","path": "math.atan.x"},
            "test": {"min": 0}
        },
        "on_true": "bs.math:atan/pade_inv",
        "on_false": {"type": "negate","input":"bs.math:atan/pade_inv"}
    },
    "on_false": {
        "type": "conditional",
        "condition": {
            "type": "float_value_check",
            "value": {"type": "storage","storage": "bs:in","path": "math.atan.x"},
            "test": {"min": 0}
        },
        "on_true": "bs.math:atan/pade",
        "on_false": {"type": "negate","input":"bs.math:atan/pade"}
    }
}
