{
    "Note":"This algorithm is taken from https://16bpp.net/blog/post/faster-acos-was-hiding-in-plain-sight/)",
    "type": "sub",
    "left": "bs.math:halfpi",
    "right": {
        "type": "conditional",
        "condition": {
            "type": "float_value_check",
            "value": {"type": "abs","input": {"type": "storage","storage": "bs:in","path": "math.acos.x"} },
            "test": {"max": 0.85}
        },
        "on_true": "bs.math:acos/pade",
        "on_false": {
            "type": "conditional",
            "condition": {
                "type": "float_value_check",
                "value": {"type": "storage","storage": "bs:in","path": "math.acos.x"},
                "test": {"min": 0}
            },
            "on_true": "bs.math:acos/pade_half",
            "on_false": {"type": "negate","input":"bs.math:acos/pade_half"}
        }
    }

}
