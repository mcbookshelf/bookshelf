> Manipulate blocks with their states and NBT, and combine block properties.

name: Block
slug: bookshelf-block
version: 5.0.0
tags: runtime
weak_dependencies: bs.log


$block_state = {
  id: #[id="block"] string > block id, such as minecraft:bookshelf
  properties?: #[as=mcdoc:block_states[[id]]] {} > block properties, omitted ones take their default
} | #[id="block"] string

$full_block_state = {
  id: #[id="block"] string > block id, such as minecraft:bookshelf
  properties: #[as=mcdoc:block_states[[id]]] {} > every property of the block and its value
}

$sounds = {
  break: #[id="sound_event"] string > sound played when the block is broken
  fall: #[id="sound_event"] string > sound played when falling onto the block
  hit: #[id="sound_event"] string > sound played when the block is hit
  place: #[id="sound_event"] string > sound played when the block is placed
  step: #[id="sound_event"] string > sound played when stepping on the block
}

$placed = state > blocks are placed in the world
$played = state > the sound is played
$summoned = state > the entity is summoned
$virtual = state > a block is loaded in the virtual storage

$play_sound = arguments: {
  block: #[id="block"] string > block whose sound to play
  source?: string > sound source, defaults to master
  targets?: string > players who will hear the sound, defaults to @a
  position?: string > position of the sound, defaults to ~ ~ ~
  pitch?: double > pitch of the sound, defaults to 1.0
  volume?: double > volume of the sound, defaults to 1.0
  min_volume?: double > minimum volume of the sound, defaults to 0.0
}


feature function load_from_item > Load the block that drops the given item.
  authors: Aksiome
  created: 2024/12/30 1.21.4
  updated: 2026/09/19 26.3

  input arguments: {
    item: #[id="item"] string > item, such as minecraft:bookshelf
  }
  output $virtual


feature function load_block > Load the whole block at the current position, id and properties.
  authors: Aksiome, theogiraudet
  created: 2024/12/30 1.21.4
  updated: 2026/09/19 26.3

  context position > position of the block to load
  output $virtual


feature function load_id > Load the block at the current position, with default properties.
  authors: Aksiome, theogiraudet
  created: 2024/12/30 1.21.4
  updated: 2026/09/19 26.3

  context position > position of the block to load
  output $virtual


feature function load_from_state > Load a block from a block id and its properties.
  authors: Aksiome
  created: 2024/12/30 1.21.4
  updated: 2026/09/19 26.3

  input arguments: {
    block: $block_state > block to load
  }
  output $virtual


feature function replace_id > Replace the block id, preserving the state when possible.
  authors: Aksiome
  created: 2024/12/30 1.21.4
  updated: 2026/09/19 26.3

  input $virtual
  input arguments: {
    block: #[id="block"] string > block to switch to
  }
  output $virtual
  output success > whether the block id exists and the replacement occurred


feature function map_id > Swap the block id for the one of its set matching the given block.
  authors: Aksiome
  created: 2024/12/30 1.21.4
  updated: 2026/09/19 26.3

  input $virtual
  input arguments: {
    block: #[id="block"] string > block to take the traits from, such as spruce_planks
    traits: [string] > traits to transfer, such as color, first ones taking priority
  }
  output $virtual
  output success > whether a matching block id was found


feature function mix_id > Swap the block id for the one of its set combining both blocks.
  authors: Aksiome
  created: 2024/12/30 1.21.4
  updated: 2026/09/19 26.3

  input $virtual
  input arguments: {
    block: #[id="block"] string > block to take the traits from, such as bricks
    traits: [string] > traits to combine, such as material, first ones taking priority
  }
  output $virtual
  output success > whether a matching block id was found


feature function replace_properties > Set property values, ignoring the ones the block does not have.
  authors: Aksiome
  created: 2024/12/30 1.21.4
  updated: 2026/09/19 26.3

  input $virtual
  input arguments: {
    properties: #[as=mcdoc:block_states[%unknown]] {} > property values to set, such as {facing:"east"}
  }
  output $virtual


feature function reset_properties > Reset properties to their default value, by name.
  authors: Aksiome
  created: 2024/12/30 1.21.4
  updated: 2026/09/19 26.3

  input $virtual
  input arguments: {
    properties: [#[as=mcdoc:block_state_keys[%unknown]] string] > names of the properties to reset, such as facing
  }
  output $virtual


feature function shift_properties > Cycle properties through their values, by any amount.
  authors: Aksiome
  created: 2024/12/30 1.21.4
  updated: 2026/09/19 26.3

  input $virtual
  input arguments: {
    properties: [{
      name: #[as=mcdoc:block_state_keys[%unknown]] string > property name, such as facing
      by?: int > number of values to shift by, defaults to 1
    }] > properties to shift
  }
  output $virtual


feature function merge_properties > Copy properties from the block at the current position, by name.
  authors: Aksiome
  created: 2024/12/30 1.21.4
  updated: 2026/09/19 26.3

  context position > position of the block to copy the properties from
  input $virtual
  input arguments: {
    properties: [#[as=mcdoc:block_state_keys[%unknown]] string] > names of the properties to copy, such as facing
  }
  output $virtual


