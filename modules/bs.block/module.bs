feature function fill_block > Fill a region with the given block.
  authors: Aksiome
  created: 2024/12/30 1.21.4
  updated: 2026/09/19 26.3

  input arguments: {
    block: string > block to fill the region with
    from: string > starting position, as a position string
    to: string > ending position, as a position string
    mode?: string > outline, hollow, destroy, keep, replace or strict, defaults to replace
    filter?: string > block predicate the replaced blocks must match, defaults to any
  }
  output $placed


feature function fill_id > Fill a region with the given block id, preserving each block state.
  authors: Aksiome
  created: 2024/12/30 1.21.4
  updated: 2026/09/19 26.3

  input arguments: {
    block: #[id="block"] string > block to fill the region with
    from: string > starting position, as a position string
    to: string > ending position, as a position string
    mode?: string > outline, hollow, destroy, keep, replace or strict, defaults to replace
    filter?: string > block predicate the replaced blocks must match, defaults to any
  }
  output $placed


