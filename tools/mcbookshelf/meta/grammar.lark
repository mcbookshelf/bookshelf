// --- document ------------------------------------------------------------- --

document: (_LEAD | _NL)? (DOC _NL)? (property | metadata)* definition* feature*

property: HEAD_KEY TEXT _NL

metadata: META_KEY TEXT _NL
        | FLAG _NL

// --- definitions ---------------------------------------------------------- --

// after the name comes what it is: a type, with its fields under it for a struct, or lines.
// One line can follow the name directly, since no line starts like a type: a paste aside,
// '$a: $b' being a type
definition: VARIABLE ":" type _end fields?                           -> alias
          | VARIABLE ":" (metadata | context | slot)                 -> block
          | VARIABLE ":" _NL _INDENT (DOC _NL)? _line+ _DEDENT      -> block
          | VARIABLE "[" items "]" ":" _NL _INDENT item_property+ _DEDENT  -> list_items
          | VARIABLE "[" items "]" _NL                                      -> list_items

items: name ("," name)*
item_property: name ":" FREE_TEXT _NL

// --- features ------------------------------------------------------------- --

feature: KW_FEATURE REGISTRY FEATURE_ID _end (_INDENT (DOC _NL)? _line* _DEDENT)?

_line: metadata | context | slot | paste

context: CONTEXT (":" type)? _end
// a colon announces a type: fields under a line without one make it a struct
slot: ROLE KIND [RESOURCE_LOCATION] [path] (":" type)? _end fields?
paste: VARIABLE _NL

fields: _INDENT (DOC _NL)? (field | paste)+ _DEDENT
field: name OPTIONAL? ":" type _end fields?

path: name ("/" name)*

// a doc is written at the end of its line, or on the next one
_end: DOC? _NL | _NL DOC _NL

// a language word is a name wherever a name is expected
?name: ID | INT | REGISTRY | ROLE | KIND | KW_FEATURE | HEAD_KEY | META_KEY | FLAG
     | STRUCT_TYPE | int_type | float_type | plain_type

// --- types ------------------------------------------------------------- -----

type: member ("|" member)*

member: ATTRIBUTE* base

?base: primitive | array | list_type | tuple_type | reference | struct

reference: VARIABLE
struct: STRUCT_TYPE

// the array words are named here directly, not through int_type: after `int @ 0..1` the
// parser must still be able to go either way, and an extra reduction would force it to choose
primitive: (array_int_type | SHORT_TYPE | STRING_TYPE) ("@" int_range)?
         | float_type ("@" float_range)?
         | plain_type
array: array_element "[" "]" ("@" int_range)?
array_element: array_int_type ("@" int_range)?
             | array_plain_type

?int_type: array_int_type | SHORT_TYPE | STRING_TYPE
?array_int_type: INT_TYPE | BYTE_TYPE | LONG_TYPE
?float_type: FLOAT_TYPE | DOUBLE_TYPE | NUMBER_TYPE
?plain_type: array_plain_type | BOOLEAN_TYPE | ANY_TYPE | XYZ_TYPE | XY_TYPE
           | OVERWORLD_TYPE | NETHER_TYPE | END_TYPE
?array_plain_type: ENTITY_TYPE | PLAYER_TYPE
list_type: "[" type "]" ("@" int_range)?
tuple_type: "[" type "," (type ("," type)*)? "]"

?int_range: INT _range INT    -> full_range
          | INT _min_range   -> min_range
          | _max_range INT   -> max_range
          | INT              -> exact_range

?float_range: number _range number  -> full_range
            | number _min_range     -> min_range
            | _max_range number     -> max_range
            | number                -> exact_range

?number: INT | FLOAT

// a '<' on a side excludes that bound
_range: RANGE | RANGE_ABOVE | RANGE_BELOW | RANGE_BETWEEN
_min_range: RANGE | RANGE_ABOVE
_max_range: RANGE | RANGE_BELOW

RANGE: ".."
RANGE_ABOVE: "<.."
RANGE_BELOW: "..<"
RANGE_BETWEEN: "<..<"

// one terminal per type word, composed by the rules above
INT_TYPE: /int\b/
BYTE_TYPE: /byte\b/
LONG_TYPE: /long\b/
SHORT_TYPE: /short\b/
STRING_TYPE: /string\b/
FLOAT_TYPE: /float\b/
DOUBLE_TYPE: /double\b/
NUMBER_TYPE: /number\b/
BOOLEAN_TYPE: /boolean\b/
ANY_TYPE: /any\b/
ENTITY_TYPE: /entity\b/
PLAYER_TYPE: /player\b/
XYZ_TYPE: /xyz\b/
XY_TYPE: /xy\b/
OVERWORLD_TYPE: /overworld\b/
NETHER_TYPE: /nether\b/
END_TYPE: /end\b/
STRUCT_TYPE: /struct\b/

OPTIONAL: "?"

// --- terminals ------------------------------------------------------------- -

// a language word wins over a name at the start of a line
KW_FEATURE.2: /feature(?![A-Za-z0-9_-])/
HEAD_KEY.2: /(name|slug|version|documentation|tags|weak_dependencies)(?![A-Za-z0-9_-])/
META_KEY.2: /(authors|contributors|since)(?![A-Za-z0-9_-])/
FLAG.2: /(deprecated|experimental)(?![A-Za-z0-9_-])/
ROLE.2: /(input|output)(?![A-Za-z0-9_-])/
CONTEXT: /@(executor|position|rotation|dimension|state)\b/

KIND: /(state|result|success|macro|storage|arguments)\b/

REGISTRY: /(context_float_provider|context_int_provider|function|loot_table|predicate|structure|block_tag|entity_type_tag)\b/

ID: /[_A-Za-z][_A-Za-z0-9-]*/

// a '$' name, defined before the features: it holds no '-', so '$axis-aligned' is '$axis'
VARIABLE: /\$[_A-Za-z][_A-Za-z0-9]*/

// the id of a feature, where a segment can be a list: 'evaluate/$spline'
FEATURE_ID: /[A-Za-z0-9_.$:\/-]+/

// a resource location wins over an identifier
RESOURCE_LOCATION.2: /[a-z0-9_-]+(\.[a-z0-9_-]+)+:[a-z0-9_.\/-]+/

// an mcdoc attribute, passed through as written
ATTRIBUTE: /#\[(?:[^\[\]]|\[(?:[^\[\]]|\[(?:[^\[\]]|\[[^\[\]]*\])*\])*\])*\]/

// a documentation continues on every following line that starts with '>', the blank and
// comment lines in between left out
DOC: />[^\r\n]*((\r?\n[ \t]*(#[^\r\n]*)?)*\r?\n[ \t]*>[^\r\n]*)*/

INT: /-?(0|[1-9][0-9]*)/
FLOAT: /-?((0|[1-9][0-9]*)\.(?!\.)[0-9]*|\.[0-9]+)/

// the value of a head or metadata word: it starts with no colon, which would make the word a field
TEXT: /[^ \t\r\n:?][^\r\n]*/
// the text of a list property
FREE_TEXT: /[^ \t\r\n][^\r\n]*/

_NL: /(\r?\n[ \t]*(#[^\r\n]*)?)+/
_LEAD: /#[^\r\n]*(\r?\n[ \t]*(#[^\r\n]*)?)*/

WS: /[ \t]+/

%ignore WS
%declare _INDENT _DEDENT
