// a resource location wins over an identifier
RESOURCE_LOCATION.2: /[a-z0-9_.-]+:[a-z0-9_.\/-]+/

ID: /\^?[_A-Za-z][_A-Za-z0-9-]*/

INT: /-?(0|[1-9][0-9]*)/

// '1.' is a float, '1..5' is a range: the dot of a fraction may not be followed by another one
FLOAT: /-?((0|[1-9][0-9]*)\.(?!\.)[0-9]*|\.[0-9]+)/

// free text to the end of the line, only ever expected after 'key:' at the start of a line
TEXT.1: /[^ \t\r\n][^\r\n]*/

// a documentation continues on every following line that starts with '>'
DOC: />[^\r\n]*(\r?\n[ \t]*>[^\r\n]*)*/

// a newline, plus every blank or comment-only line that follows it
_NL: /(\r?\n[ \t]*(#[^\r\n]*)?)+/

COMMENT: /#[^\r\n]*/
WS: /[ \t]+/

%ignore COMMENT
%ignore WS
