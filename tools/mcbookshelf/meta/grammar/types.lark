type: member ("|" member)*

// '[]' is a postfix: 'int @ 0..9 []' is an array of bounded ints, '[] @ 4' bounds the size
member: base array*
array: "[" "]" ("@" int_range)?

?base: primitive | list_type | tuple_type | struct

primitive: INT_TYPE ("@" int_range)?
         | FLOAT_TYPE ("@" float_range)?
         | PLAIN_TYPE
list_type: "[" type "]" ("@" int_range)?
tuple_type: "[" type "," (type ("," type)*)? "]"
// one entry per line, the ',' of mcdoc is allowed but not needed
struct: "{" _NL entry+ "}"
entry: ID OPTIONAL? ":" type ","? DOC? _NL

?int_range: INT _RANGE INT  -> full_range
          | INT _RANGE      -> min_range
          | _RANGE INT      -> max_range
          | INT              -> exact_range

?float_range: number _RANGE number  -> full_range
            | number _RANGE         -> min_range
            | _RANGE number         -> max_range
            | number                 -> exact_range

?number: INT | FLOAT

// a type is a whole word: 'integer' is not 'int'
INT_TYPE: /(int|byte|long|short|string)\b/
FLOAT_TYPE: /(float|double|number)\b/
PLAIN_TYPE: /(boolean|any|player|entity|xyz|xy|overworld|nether|end)\b/

OPTIONAL: "?"
_RANGE: ".."
