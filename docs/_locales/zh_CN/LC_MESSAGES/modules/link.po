msgstr "你可以在下方找到此模块中的所有可用函数。"

#: ../../modules/link.md:30 e0f339f6bb964a3ebd5087a548e8f4b5
msgid "Create Link"
msgstr "创建链接"

#: ../../modules/link.md:34 f764e2b706fa446d9a5acb9535b0409b
msgid "Create a link between the entity executing the function and the entity closest to the execution position."
msgstr "在执行函数的实体和最接近执行位置的实体之间创建链接。"

