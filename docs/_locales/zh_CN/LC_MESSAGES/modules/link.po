#: ../../modules/link.md:1 2f22dbb2627f47be9cf0c0235094af83
msgid "🔗 Link"
msgstr "🔗 链接（Link）"

#: ../../modules/link.md:3 37d910f602714e3e80f065860b3f1104
msgid "**`#bs.link:help`**"
msgstr "**`#bs.link:help`**"

#: ../../modules/link.md:5 e41d9d7b08b34b1d8bd0ce95dae7156b
msgid "Construct coherent entity structures by linking entities' positions and rotations."
msgstr "通过链接实体的位置和旋转方向来构建相连的实体结构。"

#: ../../modules/link.md:13 997b9c209bb14d88858da1666a1fffc5
msgid "\"Invisible threads are the strongest ties.\""
msgstr "“看不见的线是最强的纽带。”"

#: ../../modules/link.md:14 b56f4f1647084faa930040f12bfad61e
msgid "Friedrich Nietzsche"
msgstr "弗里德里希·尼采"

#: ../../modules/link.md:19 fe5e67e0f3bf4d52b9ab70ddace99174
msgid "This module uses scaled integers and can overflow when coordinates are higher than 2,000,000."
msgstr "此模块使用了缩放的整数，当坐标值高于 2,000,000 时可能会溢出。"

#: ../../modules/link.md:24 e467f630f70c49ecb1e1007b49ea11f3
msgid "🔧 Functions"
msgstr "🔧 函数"

#: ../../modules/link.md:26 d86308ae55b3430d9780a5f51256f954
