#: ../../modules/block.md:1460 3de226e6a0cd4e45b83e045029bda051
msgid "Can Occlude"
msgstr "是否可遮挡"

#: ../../modules/block.md:1462 dcb2bb1b9a9c4c30a3e6a4aae6f813b4
msgid "**`#bs.block:can_occlude`**"
msgstr "**`#bs.block:can_occlude`**"

#: ../../modules/block.md:1464 29a1d661e23f428bb827811d4e8fceb9
