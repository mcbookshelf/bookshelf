#: ../../modules/hitbox.md:5 8af73fda868a40e980ad13c221cdc232
msgid "Get and check the hitboxes of blocks or entities."
msgstr "获取并检查方块或实体的碰撞箱。"

#: ../../modules/hitbox.md:8 3d87cf302fd44dafbd42e6cc219f17ab
msgid "\"Talent hits a target no one else can hit; Genius hits a target no one else can see.\""
msgstr "“能者达人所不达，智者达人所未见。”"

#: ../../modules/hitbox.md:9 0571575f78a14c03bcb1ef8be05ce118
msgid "Arthur Schopenhauer"
msgstr "亚瑟·叔本华（Arthur Schopenhauer）"

